config CHIP_CHOICE
    string
    default "T5AI"

config BOARD_CHOICE
    string
    default "NICEMCU_T5_DEV"

# This board only breaks out a single UART, wired to the T5 bootROM download pins
# (UART0). The platform defaults the log to UART1, which is not accessible here, so
# route the CP-core print (all platform + TuyaOpen logs) to UART0 to share log and
# flash on the one port. The T5AI build_example.py reads this and overrides the CP
# CONFIG_UART_PRINT_PORT; boards that do not define it keep the UART1 default.
config BOARD_LOG_UART_PORT
    int
    default 0

config BOARD_CONFIG
    bool
    default y
    select ENABLE_BUTTON
    # Pin-breakout MCU: no onboard LCD / codec. Optional add-ons below.

config NICEMCU_T5_DEV_I2S_AUDIO
    bool "External I2S audio (INMP441 mic + MAX98357 amp)"
    default n
    select ENABLE_AUDIO_CODECS
    select ENABLE_I2S
    help
      Off by default: NiceMCU-T5-DEV only breaks out pins. Enable this when
      an INMP441 + MAX98357 module is wired on I2S1:
        P40=BCLK  P41=WS  P42=DIN(mic)  P43=DOUT(amp).
      There is no hardware AEC / loopback on this path.
