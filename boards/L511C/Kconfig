    prompt "Choice a board"

    config BOARD_CHOICE_L511C_Y6E
        bool "L511C_Y6E"
        if (BOARD_CHOICE_L511C_Y6E)
            rsource "./L511C_Y6E/Kconfig"
        endif

# <new-board-add: This line cannot be deleted or modified>

endchoice
