config CHIP_CHOICE
    string
    default "esp32s31"

config BOARD_CHOICE
    string
    default "ESP32S31_Korvo_1"

config BOARD_CONFIG
    bool
    default y
    select ENABLE_EXT_RAM
    select ENABLE_AUDIO
    select ENABLE_AUDIO_CODECS
    select ENABLE_DISPLAY
    select ENABLE_TP
    select ENABLE_BUTTON
    select ENABLE_BUTTON_2
    select ENABLE_BUTTON_3
    select ENABLE_BUTTON_4
    select ENABLE_LED
    select PLATFORM_FLASHSIZE_16M
    # Camera (OV3660 DVP) not enabled: the S31 DVP path needs the esp_video
    # ~2.2 stack; espressif/esp32-camera has no esp32s31 target support.

config AUDIO_CODEC_NAME
    string
    default "audio_es8389"

config LED_NAME
    string
    default "led_rgb"
