config CHIP_CHOICE
    string
    default "esp32s3"

config BOARD_CHOICE
    string
    default "SEEED_ESP32S3_XIAO_SENSE"

config BOARD_CONFIG
    bool
    default y
    select ENABLE_EXT_RAM
    select ENABLE_CAMERA
    select ENABLE_AUDIO
    select ENABLE_AUDIO_CODECS
    select ENABLE_LED if !ENABLE_SEEED_XIAO_SDCARD
    select ENABLE_BUTTON
    select PLATFORM_FLASHSIZE_8M

config ENABLE_SEEED_XIAO_MAX98357A
    bool "enable MAX98357A I2S amplifier (external module)"
    default y
    ---help---
        External MAX98357A I2S DAC/amp wired to the XIAO expansion pins:
          BCLK -> GPIO7 (D8)
          LRC  -> GPIO4 (D3)
          DIN  -> GPIO2 (D1)
          VIN  -> 5V (recommended), GND -> GND

        Prefer wiring SD (shutdown) to a free GPIO and leave it LOW until
        I2S clocks are ready; tying SD to 3V3 keeps the amp unmuted from
        power-on and will amplify floating DIN as boot noise.

        NOTE: GPIO7 is also the microSD SPI SCK when the TF card option is
        enabled, so the SD card and this amplifier are mutually exclusive.

config ENABLE_SEEED_XIAO_SDCARD
    bool "enable microSD/TF card (Sense expansion board)"
    default n
    depends on !ENABLE_SEEED_XIAO_MAX98357A
    ---help---
        Mux the microSD SPI pins on the Sense expansion board
        (SCK=IO7, MISO=IO8, MOSI=IO9, CS=IO21).

        NOTE: the card's chip-select shares GPIO21 with the onboard user LED,
        so the two are mutually exclusive. This option therefore drives the
        LED: when SD is disabled ENABLE_LED is selected (LED on GPIO21); when
        SD is enabled ENABLE_LED is left off and GPIO21 becomes the SD CS.

        Also mutually exclusive with the MAX98357A amp (both use GPIO7).
