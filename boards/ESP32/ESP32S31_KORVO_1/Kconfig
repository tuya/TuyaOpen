config CHIP_CHOICE
    string
    default "esp32s31"

config BOARD_CHOICE
    string
    default "ESP32S31_KORVO_1"

config BOARD_CONFIG
    bool
    default y
    select ENABLE_EXT_RAM
    select ENABLE_AUDIO_AEC
    select ENABLE_AUDIO_CODECS
    select ENABLE_CAMERA
    select ENABLE_DISPLAY
    select ENABLE_TP
    select ENABLE_BUTTON
    select ENABLE_BUTTON_2
    select ENABLE_BUTTON_3
    select ENABLE_BUTTON_4
    select ENABLE_LED
    select PLATFORM_FLASHSIZE_16M

# ESP32-S31 KORVO routes U0TXD/U0RXD to GPIO58/GPIO59.
config UART_NUM0_TX_PIN
    int "UART_NUM0_TX_PIN"
    default 58
    range 0 61

config UART_NUM0_RX_PIN
    int "UART_NUM0_RX_PIN"
    default 59
    range 0 61
