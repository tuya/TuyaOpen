config CHIP_CHOICE
    string
    default "esp32c2"

config BOARD_CHOICE
    string
    default "ESP32-C2"

config BOARD_CONFIG
    bool
    default y

config UART_NUM0_TX_PIN
    int "UART_NUM0_TX_PIN"
    range 0 20
    default 20
    ---help---
        esp32-c2 default 20

config UART_NUM0_RX_PIN
    int "UART_NUM0_RX_PIN"
    range 0 20
    default 19
    ---help---
        esp32-c2 default 19
