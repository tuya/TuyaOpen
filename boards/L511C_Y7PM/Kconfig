    prompt "Choice a board"

    config BOARD_CHOICE_L511C_Y7PM
        bool "L511C_Y7PM board"
        if (BOARD_CHOICE_L511C_Y7PM)
            rsource "./L511C_Y7PM/Kconfig"
        endif

# <new-board-add: This line cannot be deleted or modified>

