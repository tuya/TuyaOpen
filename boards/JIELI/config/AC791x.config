# CONFIG_ENABLE_NIMBLE is not set
CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC79_DEVKITBOARD=y
CONFIG_JIELI_UART_LOG_PORT=1
CONFIG_JIELI_UART_LOG_BAUDRATE=115200
CONFIG_ENABLE_BT_SERVICE=y
CONFIG_AI_HEAP_IN_PSRAM=y
CONFIG_AI_STACK_IN_PSRAM=y
CONFIG_STACK_SIZE_WORK_QUEUE=8192
CONFIG_STACK_SIZE_MSG_QUEUE=10240
CONFIG_ENABLE_BUTTON=y
CONFIG_ENABLE_LED=y
