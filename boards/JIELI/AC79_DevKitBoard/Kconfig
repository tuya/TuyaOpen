config BOARD_CONFIG
    bool
    default y

config CHIP_WL82
    bool
    default y

# ---------------------------------------------------------------------------
# Hardware facts the platform stages into the vendor SDK. See
# ../AC792N_Develop_Board/Kconfig for what the fields mean; the two boards
# declare the same names so the platform reads one set either way.
# ---------------------------------------------------------------------------

config JIELI_BOARD_USB_ROLE
    string
    default "device"
    help
        "host" for a host port (the vendor's TCFG_HUSB_DEVICE), "device" for a
        full-speed device port (TCFG_FUSB_DEVICE).

config JIELI_BOARD_FLASH_MIB
    int
    default 8

config JIELI_BOARD_SDRAM_MIB
    int
    default 8

config JIELI_BOARD_EXTERNAL_DDR
    bool
    default n
    help
        Whether the board populates the external DDR. The vendor SDK disables
        it with CONFIG_NO_SDRAM_ENABLE unless this says otherwise.

config JIELI_BOARD_DUAL_BANK
    bool "Dual-bank (A/B) OTA layout"
    default n
    help
        Build the vendor dual-bank (A/B) OTA engine: stages
        CONFIG_DOUBLE_BANK_ENABLE into the vendor app config, so
        support_dual_bank_update_en is 1. The flasher then lays out two
        application banks below the TuyaOpen span and a 32 KiB VM just under
        it; the span base in tkl_flash.c (0x700000) is what sizes them.
        Measured with the guided-UI image on this board: banks of 0x37C000
        each (0x20020..0x37C000 and 0x37C000..0x6F8000), VM at 0x6F8000.
        Switching a device between single-bank and dual-bank layouts needs a
        full flash: the vendor forbids upgrading across the two.

config JIELI_BOARD_LOG_UART_PORT
    int
    default 1

config JIELI_BOARD_LOG_UART_TX_PIN
    string
    default "IO_PORTB_03"
    help
        Only a chip whose staged board file has to be rewritten needs this.
        Empty means the vendor header keeps the pin it already has.

config JIELI_BOARD_HAS_SERVICE_UART
    bool
    default y
    help
        Whether the board carries the second UART the TAL CLI is routed to.

if JIELI_BOARD_HAS_SERVICE_UART
    config JIELI_BOARD_SERVICE_UART_PORT
        int
        default 0

    config JIELI_BOARD_SERVICE_UART_TX_PIN
        string
        default "IO_PORTB_06"

    config JIELI_BOARD_SERVICE_UART_RX_PIN
        string
        default "IO_PORTB_07"
endif

config JIELI_BOARD_HAS_DISPLAY
    bool
    default n

choice JIELI_BOARD_TP_CONTROLLER
    prompt "AC79 DevKitBoard touch controller"
    default JIELI_BOARD_TP_FT6236

    config JIELI_BOARD_TP_FT6236
        bool "FT6236/FT6336 (I2C 0x38)"

    config JIELI_BOARD_TP_GT911
        bool "GT911 (I2C 0x14)"
endchoice

config JIELI_BOARD_TP_INT_PIN
    int "Touch INT pin (flat GPIO number)"
    range 0 127
    default 20
    help
      PB4 on V1.0. V1.2 maps PB0 to TP_INT instead; confirm the board
      revision before changing this.

config JIELI_BOARD_TP_RST_PIN
    int "Touch RESET pin (flat GPIO number)"
    range 0 127
    default 16
    help
      PB0 on V1.0. V1.2 maps PB4 to TP_RESET instead. The reset is shared
      with the LCD unless JIELI_BOARD_TP_RST_SHARED_WITH_LCD is cleared.

config JIELI_BOARD_TP_RST_SHARED_WITH_LCD
    bool "Touch RESET is shared with the LCD reset"
    default y
    help
      PB0 resets both the panel and the touch controller. The 8080 display
      backend owns PB0, so the touch driver leaves it alone and relies on
      the panel reset. Clear this only after verifying a dedicated touch
      reset line.

config JIELI_BOARD_TP_X_MAX
    int "Touch X resolution"
    range 1 4096
    default 320

config JIELI_BOARD_TP_Y_MAX
    int "Touch Y resolution"
    range 1 4096
    default 480

config JIELI_BOARD_TP_SWAP_XY
    bool "Swap touch X/Y"
    default n

config JIELI_BOARD_TP_MIRROR_X
    bool "Mirror touch X"
    default n

config JIELI_BOARD_TP_MIRROR_Y
    bool "Mirror touch Y"
    default n

# ---------------------------------------------------------------------------
# Camera modules. Two connectors share PA2/PA3/PA4 and PH0-PH3 (I2C/XCLK/RESET),
# and both modules answer on I2C 0x42, so exactly one can be fitted and built:
#
#   J1  24-pin DVP  -> GC2145, PA0-PA10 + PH0-PH3
#   J4  12-pin SPI  -> GC0310, PA2/PA3/PA4 + PH0-PH3
#
# A different module is a new entry plus its TDD sensor driver. The platform
# only sees which capture backend the selected module needs, staged as
# JIELI_BOARD_CAMERA_DVP / JIELI_BOARD_CAMERA_SPI.
# ---------------------------------------------------------------------------
choice
    prompt "Camera module"
    # The 24-pin DVP module (J1) is the one the devkit ships with.
    default JIELI_BOARD_CAMERA_GC2145

    config JIELI_BOARD_CAMERA_NONE
        bool "None"

    config JIELI_BOARD_CAMERA_GC2145
        bool "GC2145 on J1 (24-pin DVP)"
        # PH2/PH3 are the camera XCLK/RESET and also TKL UART1's fixed pins.
        depends on !JIELI_BOARD_UART1_ENABLE
        select ENABLE_CAMERA
        select ENABLE_DVP

    config JIELI_BOARD_CAMERA_GC0310
        bool "GC0310 on J4 (12-pin SPI)"
        # Same XCLK/RESET pins as the DVP module, same UART1 conflict.
        depends on !JIELI_BOARD_UART1_ENABLE
        select ENABLE_CAMERA
        select ENABLE_DVP

endchoice

if JIELI_BOARD_CAMERA_GC2145 || JIELI_BOARD_CAMERA_GC0310
    config JIELI_BOARD_CAMERA_WIDTH
        int "Camera frame width"
        default 640 if JIELI_BOARD_CAMERA_GC2145
        default 320 if JIELI_BOARD_CAMERA_GC0310
        range 64 640

    config JIELI_BOARD_CAMERA_HEIGHT
        int "Camera frame height"
        default 480 if JIELI_BOARD_CAMERA_GC2145
        default 240 if JIELI_BOARD_CAMERA_GC0310
        range 64 480

    config JIELI_BOARD_CAMERA_FPS
        int "Camera frame rate"
        default 20 if JIELI_BOARD_CAMERA_GC2145
        default 12 if JIELI_BOARD_CAMERA_GC0310
        range 1 30
endif

# TKL UART1 is the SDK's uart2 block, which has one fixed pin group on this
# chip: PH2 (TX) / PH3 (RX). PH2 is also the PWM0 timer output, so a project
# uses one or the other, not both.
#
# Off by default because opening uart2 on this SDK stops the vendor debug
# console: output stops on PB3 and does not move to the uart2 pins either. That
# is tolerable for a product that does not need logs and needs a second UART,
# and unacceptable while developing. PORT_REMAP behaves the same way.
config JIELI_BOARD_UART1_ENABLE
    bool "Expose TKL UART1 (SDK uart2, replaces the debug console)"
    default n

if JIELI_BOARD_UART1_ENABLE
config JIELI_BOARD_UART1_TX_PIN
    int "UART1 TX pin (flat GPIO number)"
    range 0 127
    default 114

config JIELI_BOARD_UART1_RX_PIN
    int "UART1 RX pin (flat GPIO number)"
    range 0 127
    default 115
endif

# TKL PWM0 is the TIMER2 output, which takes a single pin (no H/L pair).
config JIELI_BOARD_PWM0_PIN
    int "PWM0 (TIMER2 output) pin (flat GPIO number)"
    range 0 127
    default 114

# TKL IIC pins. IIC0 is the software (bit-banged) port on this chip and IIC1
# the hardware one; both take their pins from platform data.
config JIELI_BOARD_IIC0_SCL_PIN
    int "IIC0 (software IIC) SCL pin (flat GPIO number)"
    range 0 127
    # The camera module's I2C is wired to PH0. The vendor DVP driver opens
    # iic0 for ISP_DEV_0, so the adapter's software-IIC node must move there
    # when the DVP module is fitted; the PA0/PA1 default would not probe. The
    # SPI module keeps iic0 on the same pads: a vendor probe that still runs
    # as ISP_DEV_0 would otherwise NACK there.
    default 112 if JIELI_BOARD_CAMERA_GC2145 || JIELI_BOARD_CAMERA_GC0310
    default 0

config JIELI_BOARD_IIC0_SDA_PIN
    int "IIC0 (software IIC) SDA pin (flat GPIO number)"
    range 0 127
    default 113 if JIELI_BOARD_CAMERA_GC2145 || JIELI_BOARD_CAMERA_GC0310
    default 1

config JIELI_BOARD_IIC1_SCL_PIN
    int "IIC1 SCL pin (flat GPIO number)"
    range 0 127
    # The SPI sensor's control bus is wired to PH0/PH1. Those pads also carry
    # the sensor's 2-wire SPI output, so the adapter bit-bangs them instead of
    # handing them to the hardware controller; the pin choice alone makes that
    # call, there is no separate switch to set.
    default 112 if JIELI_BOARD_CAMERA_GC0310
    default 7

config JIELI_BOARD_IIC1_SDA_PIN
    int "IIC1 SDA pin (flat GPIO number)"
    range 0 127
    default 113 if JIELI_BOARD_CAMERA_GC0310
    default 8
