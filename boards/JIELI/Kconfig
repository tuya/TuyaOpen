config PLATFORM_CHOICE
    string
    default "JIELI"

config CHIP_CHOICE
    string
    default "wl83" if BOARD_CHOICE_AC792N_DEVELOP_BOARD || BOARD_CHOICE_AC7921A
    default "wl82"

config BOARD_CHOICE
    string
    default "AC792N_Develop_Board" if BOARD_CHOICE_AC792N_DEVELOP_BOARD || BOARD_CHOICE_AC7921A
    default "AC79_DevKitBoard"

config PLATFORM_JIELI
    bool
    default y

config OPERATING_SYSTEM
    int
    default 98

config LITTLE_END
    int
    default 1

config ENABLE_UART
    bool
    default y

config ENABLE_WIFI
    bool
    default y

config ENABLE_BLUETOOTH
    bool
    default y

# Tuya's generic audio codec layer compiles tdd_audio.c only when this
# platform-scoped media switch is enabled. Keep it opt-in for Jieli boards.
config ENABLE_MEDIA
    bool "Enable Jieli media/audio codecs"
    default n
    select ENABLE_AUDIO_CODECS
    help
        Enable the TuyaOpen TDD audio codec on Jieli WL82/WL83 targets.
        This option is scoped to the Jieli board catalog.

config ENABLE_JIELI_NATIVE_KEY
    bool "Use the native Jieli ADKEY event as the AI chat button"
    default y
    depends on ENABLE_MEDIA
    help
        Route the board K1 ADKEY events from the Jieli SDK to Tuya's AI HOLD
        mode. Jieli board keys are ADC ladder inputs, not GPIO buttons.

config ENABLE_JIELI_ADKEY_BUTTON
    bool "Register the Jieli K1 ADKEY through Tuya Button TDL"
    default n
    select ENABLE_BUTTON
    select ENABLE_BUTTON_ADC
    help
        Register the board K1 ADC ladder as a standard Tuya ADC button so apps
        can receive debounced press and release events through TDL.

config JIELI_UART_LOG_PORT
    int "SDK UART controller used for logging"
    default 1 if BOARD_CHOICE_AC79_DEVKITBOARD || BOARD_CHOICE_AC7916A
    default 0
    range 0 5

config JIELI_UART_LOG_BAUDRATE
    int "UART log baud rate"
    default 1000000 if BOARD_CHOICE_AC79_DEVKITBOARD || BOARD_CHOICE_AC7916A
    default 1000000 if BOARD_CHOICE_AC792N_DEVELOP_BOARD || BOARD_CHOICE_AC7921A
    default 115200
    range 1200 4000000

config JIELI_MINIMAL_HELLO
    bool "Build the minimal UART board bring-up image"
    default y if BOARD_CHOICE_AC792N_DEVELOP_BOARD || BOARD_CHOICE_AC7921A
    default n
    help
        Build a small UART-only image for initial AC792 board bring-up.
        Disable this option when enabling the full TuyaOpen application stack.

config ENABLE_CHIP_WL83
    bool "Enable the AC792N board"
    default y
    help
        Enable the AC792N_Develop_Board (AC7926A reference profile).

choice
    prompt "Choice a Jieli board"
    default BOARD_CHOICE_AC79_DEVKITBOARD

    config BOARD_CHOICE_AC79_DEVKITBOARD
        bool "AC79_DevKitBoard (AC791)"

    config BOARD_CHOICE_AC7916A
        bool "AC7916A (legacy config alias; same board)"

    config BOARD_CHOICE_AC792N_DEVELOP_BOARD
        bool "AC792N_Develop_Board (AC7926A reference profile)"
        depends on ENABLE_CHIP_WL83

    config BOARD_CHOICE_AC7921A
        bool "AC7921A (legacy config alias; AC792N profile)"
        depends on ENABLE_CHIP_WL83

endchoice

if BOARD_CHOICE_AC79_DEVKITBOARD || BOARD_CHOICE_AC7916A
    rsource "./AC79_DevKitBoard/Kconfig"
endif

if BOARD_CHOICE_AC792N_DEVELOP_BOARD || BOARD_CHOICE_AC7921A
    rsource "./AC792N_Develop_Board/Kconfig"
endif
