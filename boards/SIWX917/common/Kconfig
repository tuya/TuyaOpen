            config I2C0_SDA_PIN_6
                bool "GPIO_6"
            config I2C0_SDA_PIN_64
                bool "ULP_GPIO_0/GPIO_64"
            config I2C0_SDA_PIN_67
                bool "ULP_GPIO_3/GPIO_67"
            config I2C0_SDA_PIN_74
                bool "ULP_GPIO_10/GPIO_74"
            config I2C0_SDA_PIN_31
                bool "GPIO_31"
        endchoice

