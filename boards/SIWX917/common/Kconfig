config TUYAOPEN_PERIPHERAL_CONFIG
    bool
    default y

#ULP_UART Configuration(TUYA_UART_NUM_0)
    config ENABLE_ULP_UART
        bool "Enable TUYA_UART_NUM_0 (ULP_UART)"
        default n
        help
            Enable ULP UART interface for ultra-low-power serial communication.

    if ENABLE_ULP_UART
        choice RTE_ULP_UART_TX_PORT_ID
            prompt "ULP_UART_TX_PIN"
            default ULP_UART_TX_PIN_11

            config ULP_UART_TX_PIN_7
                bool "ULP_GPIO_7/GPIO_71"
            config ULP_UART_TX_PIN_11
                bool "ULP_GPIO_11/GPIO_75"
            config ULP_UART_TX_PIN_9
                bool "GPIO_9"
            config ULP_UART_TX_PIN_15
                bool "GPIO_15"
            config ULP_UART_TX_PIN_49
                bool "GPIO_49"
        endchoice

        config RTE_ULP_UART_TX_PORT_ID
            int
            default 0 if ULP_UART_TX_PIN_7
            default 1 if ULP_UART_TX_PIN_11
            default 2 if ULP_UART_TX_PIN_9
            default 3 if ULP_UART_TX_PIN_15
            default 5 if ULP_UART_TX_PIN_49

        choice RTE_ULP_UART_RX_PORT_ID
            prompt "ULP_UART_RX_PIN"
            default ULP_UART_RX_PIN_9

            config ULP_UART_RX_PIN_6
                bool "ULP_GPIO_6/GPIO_70"
            config ULP_UART_RX_PIN_9
                bool "ULP_GPIO_9/GPIO_73"
            config ULP_UART_RX_PIN_2
                bool "GPIO_2/GPIO_66"
            config ULP_UART_RX_PIN_8
                bool "GPIO_8"
            config ULP_UART_RX_PIN_12
                bool "GPIO_12"
            config ULP_UART_RX_PIN_47
                bool "GPIO_47"
        endchoice

        config RTE_ULP_UART_RX_PORT_ID
            int
            default 1 if ULP_UART_RX_PIN_6
            default 2 if ULP_UART_RX_PIN_9
            default 0 if ULP_UART_RX_PIN_2
            default 3 if ULP_UART_RX_PIN_8
            default 4 if ULP_UART_RX_PIN_12
            default 5 if ULP_UART_RX_PIN_47
    endif

