            int
            default 0 if I2C0_SDA_PIN_6
            default 1 if I2C0_SDA_PIN_64
            default 2 if I2C0_SDA_PIN_67
            default 3 if I2C0_SDA_PIN_74
            default 4 if I2C0_SDA_PIN_31
    endif

