# TKL adapter capabilities for the GD32H77X board family.
config LITTLE_END
    int
    default 1
    ---help---
        0       /* big endian */
        1       /* little endian */

config ENABLE_PLATFORM_MBEDTLS
    bool
    default n

config ENABLE_WIFI
    bool "Enable Wi-Fi adapter"
    default y

config ENABLE_BLUETOOTH
    bool "Enable BLE adapter"
    default y

config ENABLE_NIMBLE
    bool
    default n
    help
      GD32H77X exposes Bluetooth through the AT-based tkl_bluetooth backend.
      Do not build the NimBLE host unless the platform also provides tkl_hci.

config ENABLE_WIRED
    bool "Enable wired network adapter"
    default n

config ENABLE_FLASH
    bool "Enable flash adapter"
    default y

config ENABLE_GPIO
    bool "Enable GPIO adapter"
    default y

config ENABLE_ADC
    bool "Enable ADC adapter"
    default n

config ENABLE_DVP
    bool "Enable DVP adapter"
    default y

config ENABLE_FILE_SYSTEM
    bool "Enable file system adapter"
    default n

config ENABLE_PWM
    bool "Enable PWM adapter"
    default n

config ENABLE_DMA2D
    bool "Enable DMA2D (IPA) adapter"
    default n

config ENABLE_I2C
    bool "Enable I2C adapter"
    default y

config ENABLE_SPI
    bool "Enable SPI adapter"
    default y

config ENABLE_UART
    bool "Enable UART adapter"
    default y

config ENABLE_QSPI
    bool "Enable QSPI adapter"
    default y

config ENABLE_EXT_RAM
    bool
    depends on GD32H77X_PSRAM_ACCESS_MAPPED
    default n
    help
      Enable the pointer-based TKL PSRAM heap. This is valid only when the
      OSPI PSRAM is configured for memory-mapped access. Indirect mode uses
      the explicit offset-based driver API instead.

config ENABLE_PSRAM
    bool "Enable mapped PSRAM block allocator"
    default y if BOARD_CHOICE_GD32H779I_DESK_BUDDY
    default y if BOARD_CHOICE_GD32H77EI_DESK_BUDDY
    default n
    help
      Expose tkl_system_psram_malloc/free for explicitly selected large
      blocks. Allocations are 32-byte aligned and the region is mapped as
      non-cacheable Device memory. Use the PSRAM ring or copy helpers for
      data movement; do not treat these blocks as a general C pointer heap.
