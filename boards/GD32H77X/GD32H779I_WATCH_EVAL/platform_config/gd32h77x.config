# DFU programs ECNVM first (4 KiB pages, verified) and then CNVM
# boot+primary (64 KiB sectors, verified) for the full default layout.
CONFIG_ENABLE_GD32H77X_FLASH_BACKEND_DFU=y

# Watch EVAL supplies VCORE_0V9 from external U12 SGM2036.
CONFIG_GD32H77X_PMU_SMPS_MODE="bypass"

# H77 console: USART0 TX PF4 / RX PF5 through CH9114F.
CONFIG_ENABLE_GD32H77X_CONSOLE_UART_USART0=y
CONFIG_ENABLE_GD32H77X_CONSOLE_GPIO_PORT_F=y
CONFIG_GD32H77X_CONSOLE_TX_PIN_NUMBER=4
CONFIG_GD32H77X_CONSOLE_RX_PIN_NUMBER=5
CONFIG_GD32H77X_CONSOLE_AF_NUMBER=4
