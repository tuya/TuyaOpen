# SWD uses the committed GD32H77x CMSIS-Pack flash algorithm and works with
# the CMSIS-DAP probe on the board bring-up header.
# SWD alternative (enable when using the CMSIS-DAP probe):
# CONFIG_ENABLE_GD32H77X_FLASH_BACKEND_SWD is not set
CONFIG_ENABLE_GD32H77X_FLASH_BACKEND_DFU=y

# DESK BUDDY supplies VCORE_0V9 from external U12 SGM2036.
CONFIG_GD32H77X_PMU_SMPS_MODE="bypass"

# Q3/Q3A power latch: hold the supply on before starting services.
CONFIG_ENABLE_GD32H77X_POWER_HOLD=y
CONFIG_GD32H77X_POWER_HOLD_GPIO="PC13"
CONFIG_ENABLE_GD32H77X_POWER_HOLD_ACTIVE_HIGH=y

# H77 console: USART0 TX PF4 / RX PF5 through CH9114F.
CONFIG_ENABLE_GD32H77X_CONSOLE_UART_USART0=y
CONFIG_ENABLE_GD32H77X_CONSOLE_GPIO_PORT_F=y
CONFIG_GD32H77X_CONSOLE_TX_PIN_NUMBER=4
CONFIG_GD32H77X_CONSOLE_RX_PIN_NUMBER=5
CONFIG_GD32H77X_CONSOLE_AF_NUMBER=4

# New PCB TY1: hardware SPI1 Mode0, CS_ONLY v2 with DMA.
CONFIG_ENABLE_GD32H77X_AT_TRANSPORT_SPI=y
CONFIG_ENABLE_GD32H77X_AT_SPI_PSC_256=y
CONFIG_ENABLE_GD32H77X_AT_SPI_CS_ONLY=y
CONFIG_GD32H77X_AT_SPI_NUMBER=1
CONFIG_GD32H77X_AT_SPI_SCK="PC3"
CONFIG_GD32H77X_AT_SPI_MISO="PC2"
CONFIG_GD32H77X_AT_SPI_MOSI="PC1"
CONFIG_GD32H77X_AT_SPI_CS="PC0"
CONFIG_ENABLE_GD32H77X_AT_RESET_GPIO_PORT_H=y
CONFIG_GD32H77X_AT_RESET_PIN_NUMBER=10
CONFIG_ENABLE_GD32H77X_AT_SHARED_RESET=y

# APS6404L-3SQR-SN on OSPI0 / OSPIM Port0.
CONFIG_ENABLE_GD32H77X_PSRAM=y
CONFIG_GD32H77X_PSRAM_PROFILE="APS6404L-3SQR"
# Bring-up uses the explicit indirect API; do not enter the mapped window.
# CONFIG_GD32H77X_PSRAM_ACCESS_INDIRECT is not set
CONFIG_GD32H77X_PSRAM_ACCESS_MAPPED=y
CONFIG_GD32H77X_PSRAM_OSPIM_PORT0=y
CONFIG_GD32H77X_PSRAM_CS_PIN="PE11"
CONFIG_GD32H77X_PSRAM_SCK_PIN="PB2"
CONFIG_GD32H77X_PSRAM_IO0_PIN="PA2"
CONFIG_GD32H77X_PSRAM_IO1_PIN="PB0"
CONFIG_GD32H77X_PSRAM_IO2_PIN="PA3"
CONFIG_GD32H77X_PSRAM_IO3_PIN="PA1"
CONFIG_GD32H77X_PSRAM_CLOCK_HZ=75000000
CONFIG_GD32H77X_PSRAM_SIZE_MB=8
CONFIG_GD32H77X_PSRAM_HEAP_OFFSET_KB=4096
CONFIG_GD32H77X_PSRAM_HEAP_SIZE_KB=4096

CONFIG_ENABLE_GD32H77X_FLASH_DFU_AUTOSTART=y
