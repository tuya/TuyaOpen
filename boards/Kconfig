config BOARD_ENABLE_LINUX
    bool
    default y

config BOARD_ENABLE_T3
    bool
    default y

config BOARD_ENABLE_T5AI
    bool
    default y

config BOARD_ENABLE_ESP32
    bool
    default y

config BOARD_ENABLE_GD32
    bool
    default y

config BOARD_ENABLE_SIWX917
    bool
    default y

config BOARD_ENABLE_T9
    bool
    default y

config BOARD_ENABLE_JIELI
    bool
    default y

# <new-board-enable: This line cannot be deleted or modified>


choice
    prompt "Choice a board"

if (BOARD_ENABLE_LINUX)
    config BOARD_CHOICE_LINUX
        bool "LINUX"
    if (BOARD_CHOICE_LINUX)
    rsource "./LINUX/Kconfig"
    endif
endif

if (BOARD_ENABLE_T3)
    config BOARD_CHOICE_T3
        bool "T3"
    if (BOARD_CHOICE_T3)
    rsource "./T3/Kconfig"
    endif
endif

if (BOARD_ENABLE_T5AI)
    config BOARD_CHOICE_T5AI
        bool "T5AI"
    if (BOARD_CHOICE_T5AI)
    rsource "./T5AI/Kconfig"
    endif
endif

if (BOARD_ENABLE_ESP32)
    config BOARD_CHOICE_ESP32
        bool "ESP32"
    if (BOARD_CHOICE_ESP32)
    rsource "./ESP32/Kconfig"
    endif
endif

if (BOARD_ENABLE_GD32)
    config BOARD_CHOICE_GD32
        bool "GD32"
    if (BOARD_CHOICE_GD32)
    rsource "./GD32/Kconfig"
    endif
endif

if (BOARD_ENABLE_SIWX917)
    config BOARD_CHOICE_SIWX917
        bool "SIWX917"
    if (BOARD_CHOICE_SIWX917)
    rsource "./SIWX917/Kconfig"
    endif
endif

if (BOARD_ENABLE_T9)
    config BOARD_CHOICE_T9
        bool "T9"
    if (BOARD_CHOICE_T9)
    rsource "./T9/Kconfig"
    endif
endif

if (BOARD_ENABLE_JIELI)
    config BOARD_CHOICE_JIELI
        bool "JIELI"
    if (BOARD_CHOICE_JIELI)
    rsource "./JIELI/Kconfig"
    endif
endif

# <new-board-kconfig: This line cannot be deleted or modified>

endchoice
