# Dedicated board-default config for the LCKFB K230 (LushanPi K230).
# Apply to an app with:  tos.py config choice -d -c lckfb_k230
# (copies this file to the app's app_default.config).
#
# Minimal first-build: Wi-Fi/wired/BT off (Stage 3+). switch_demo will build
# and boot with basic TKLs (OS + gpio + uart + flash); cloud connectivity
# arrives with the Wi-Fi TKL (onboard RTL8189FTV) in Stage 3.
CONFIG_BOARD_CHOICE_KENDRYTE_K230=y
CONFIG_BOARD_CHOICE_LCKFB_K230=y
CONFIG_ENABLE_BT_SERVICE=n
