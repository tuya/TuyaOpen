/**
 * @file tuya_config_secrets.h.example
 * @brief Template for the gitignored tuya_config_secrets.h.
 *
 * Copy to tuya_config_secrets.h and fill in a license issued for this app's PID.
 * Get one from https://platform.tuya.com/purchase/index?type=6
 *
 * The license is bound to a PID. This app's PID comes from Kconfig
 * (CONFIG_TUYA_PRODUCT_ID in app_default.config), so a license for a different
 * product needs that setting changed too — it cannot be set here.
 */

#ifndef __TUYA_CONFIG_SECRETS_H__
#define __TUYA_CONFIG_SECRETS_H__

#ifdef __cplusplus
extern "C" {
#endif

// clang-format off
#define TUYA_OPENSDK_UUID      "uuidxxxxxxxxxxxxxxxx"
#define TUYA_OPENSDK_AUTHKEY   "your_authkey"
// clang-format on

#ifdef __cplusplus
}
#endif

#endif /* __TUYA_CONFIG_SECRETS_H__ */
