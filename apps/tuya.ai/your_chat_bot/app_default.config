CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC792N_DEVELOP_BOARD=y
# CONFIG_JIELI_MINIMAL_HELLO is not set
CONFIG_ENABLE_BT_SERVICE=y
# CONFIG_ENABLE_NIMBLE is not set
CONFIG_ENABLE_MEDIA=y
CONFIG_ENABLE_AUDIO_CODECS=y
CONFIG_ENABLE_AI_COMPONENTS=y
CONFIG_ENABLE_COMP_AI_MODE_HOLD=y
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
# CONFIG_ENABLE_COMP_AI_MODE_WAKEUP is not set
# CONFIG_ENABLE_COMP_AI_MODE_FREE is not set
CONFIG_ENABLE_BUTTON=y
CONFIG_ENABLE_JIELI_ADKEY_BUTTON=y
# Audio-only boards have no Tuya display/GPIO backend.
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
# CONFIG_ENABLE_DISPLAY is not set
# CONFIG_ENABLE_LIBLVGL is not set
# wq_highpri runs the BLE netcfg completion chain (cJSON parse of the ~960B
# provisioning payload + littlefs KV write + token split + WiFi connect
# dispatch); the 4096+1024 default overflowed it and corrupted FreeRTOS
# list nodes (axi_rd_inv in vListInsert/vTaskPlaceOnEventList, 2026-09-18).
# switch_demo carries this fix; your_chat_bot did not, and on AC792N it crashed
# and rebooted at ~0.47 s, right as wq_highpri started.
CONFIG_STACK_SIZE_MSG_QUEUE=10240
# wq_system later runs the netmgr/TLS activation chain; same headroom.
CONFIG_STACK_SIZE_WORK_QUEUE=8192
