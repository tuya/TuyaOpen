CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_BOARD_CHOICE_T9=y
CONFIG_ENABLE_CUSTOM_CONFIG=y
CONFIG_ENABLE_EXT_RAM=y
CONFIG_ENABLE_WIFI=y
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_OPUS=y
# CONFIG_ENABLE_TUYAOPEN_OPUS is not set
CONFIG_AI_INPUT_STACK_SIZE=28672
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
# CONFIG_ENABLE_COMP_AI_VIDEO is not set
# CONFIG_ENABLE_COMP_AI_PICTURE is not set
# CONFIG_ENABLE_CAMERA is not set
# CONFIG_ENABLE_COMP_AI_MODE_HOLD is not set
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
CONFIG_ENABLE_COMP_AI_MODE_WAKEUP=y
CONFIG_ENABLE_COMP_AI_MODE_FREE=y
