CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_OPUS=y
CONFIG_ENABLE_COMP_AI_DISPLAY=y
CONFIG_ENABLE_AI_CHAT_GUI_WECHAT=y
CONFIG_ENABLE_SDL_DISPLAY=y
CONFIG_ENABLE_SDL_TP=y
CONFIG_SDL_DISPLAY_WIDTH=480
CONFIG_SDL_DISPLAY_HEIGHT=480
CONFIG_SDL_DISPLAY_TITLE="TuyaOpen - your_chat_bot"
CONFIG_ENABLE_UART=y
CONFIG_KWS_MODEL_PATH="~/tuyaopen_models/mdtc_chunk_300ms.mnn"
CONFIG_KWS_MODEL_TOKEN_PATH="~/tuyaopen_models/tokens.txt"
CONFIG_BOARD_CHOICE_TaishanPi_3=y
CONFIG_ENABLE_KEYBOARD_INPUT=y
CONFIG_BUTTON_NAME="s"
CONFIG_ENABLE_TUYA_CODEC_OPUS=y
# CONFIG_ENABLE_TUYA_CODEC_OPUS_IPC is not set
CONFIG_ENABLE_AUDIO_ALSA=y
