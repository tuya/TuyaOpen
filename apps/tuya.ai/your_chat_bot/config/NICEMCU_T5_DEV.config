CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_NICEMCU_T5_DEV=y
# Optional INMP441 + MAX98357 on I2S1 (P40/P41/P42/P43); off by default
# CONFIG_NICEMCU_T5_DEV_I2S_AUDIO=y
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
# Headless: no LCD — keep LVGL/AI display off or LVGL will reboot
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
# CONFIG_ENABLE_LIBLVGL is not set
# CONFIG_ENABLE_DISPLAY is not set
