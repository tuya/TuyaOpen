CONFIG_PROJECT_VERSION="1.0.2"
CONFIG_TUYA_PRODUCT_ID="gfmuakglqja0aqxk"
CONFIG_ENABLE_AI_LANGUAGE_ENGLISH=y
CONFIG_ENABLE_COMP_AI_MODE_HOLD=y
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
# CONFIG_ENABLE_COMP_AI_MODE_WAKEUP is not set
# CONFIG_ENABLE_COMP_AI_MODE_FREE is not set
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
CONFIG_BOARD_CHOICE_SIWX917=y
CONFIG_BOARD_CHOICE_SIWX917_AI_DEV_KIT=y
CONFIG_ENABLE_ULP_UART=y
CONFIG_TUYA_HS_BLE_HOST_STACK_SIZE=3072
# Keep large AI buffers (latest defaults 20KB are too small and stutter easily)
CONFIG_AI_INPUT_RINGBUF_SIZE=327680
CONFIG_AI_OUTPUT_RINGBUF_SIZE=131072
CONFIG_AI_MAX_FRAGMENT_LENGTH=1152
# Pinned to AI protocol v1 (the TuyaOpen v1.6.0 default): v2 stutters on TTS on
# this board. Re-evaluate once the v2 audio path is verified on SiWx917.
CONFIG_AI_VERSION=1
CONFIG_ENABLE_LIBLWIP=y
CONFIG_MEM_SIZE=63488
CONFIG_MEMP_NUM_PBUF=256
CONFIG_IP_REASS_MAX_PBUFS=16
CONFIG_PBUF_POOL_SIZE=64
CONFIG_PBUF_LINK_ENCAPSULATION_HLEN=0
CONFIG_TCP_SND_BUF=23360
CONFIG_TCP_SND_QUEUELEN=48
CONFIG_LWIP_NETIF_HOSTNAME=1
CONFIG_LWIP_TCPIP_CORE_LOCKING=1
CONFIG_LWIP_EAPOL_SUPPORT=0
CONFIG_LWIP_TX_PBUF_ZERO_COPY=0
CONFIG_CONFIG_TUYA_SOCK_SHIM=0
CONFIG_LWIP_NETCONN_SEM_PER_THREAD=0
CONFIG_ETHARP_SUPPORT_STATIC_ENTRIES=1
CONFIG_LWIP_NETIF_STATUS_CALLBACK=1
CONFIG_ENABLE_LWIP_DHCPD=y
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
CONFIG_ENABLE_CUSTOM_CONFIG=y
CONFIG_ENABLE_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=y
CONFIG_STACK_SIZE_TIMERQ=3072
CONFIG_STACK_SIZE_WORK_QUEUE=3072
CONFIG_STACK_SIZE_MSG_QUEUE=3072
# PSRAM path required by latest AI output/input (ENABLE_EXT_RAM) + SiWx917 adapter (CONFIG_SPIRAM)
CONFIG_ENABLE_EXT_RAM=y
CONFIG_CONFIG_SPIRAM=y
CONFIG_AI_STACK_IN_PSRAM=y
CONFIG_AI_HEAP_IN_PSRAM=y
# CONFIG_ENABLE_LIBLVGL is not set
# CONFIG_ENABLE_DISPLAY is not set
CONFIG_ENABLE_BUTTON=y
CONFIG_BUTTON_NUM=3
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_BUTTON_NAME_2="SW2"
CONFIG_BUTTON_NAME_3="SW3"
CONFIG_ENABLE_LED=y
CONFIG_LED_NUM=3
CONFIG_LED_NAME="LEDB"
CONFIG_LED_NAME_2="LEDG"
CONFIG_LED_NAME_3="LEDR"
