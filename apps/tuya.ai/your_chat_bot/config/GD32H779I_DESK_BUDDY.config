CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_BOARD_CHOICE_GD32H77X=y
CONFIG_BOARD_CHOICE_GD32H779I_DESK_BUDDY=y
# CONFIG_ENABLE_PSRAM is not set
# CONFIG_ENABLE_DESK_BUDDY_PERIPHERALS is not set
CONFIG_ENABLE_DESK_BUDDY_AUDIO=y
CONFIG_DESK_BUDDY_AUDIO_PLAYBACK_MP3=y
CONFIG_ENABLE_DESK_BUDDY_BUTTON=y
CONFIG_ENABLE_BUTTON=y
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_BUTTION_STACK_SIZE=4096
CONFIG_ENABLE_AI_COMPONENTS=y
CONFIG_ENABLE_COMP_AI_PRESENT_MODE=y
CONFIG_ENABLE_COMP_AI_MODE_HOLD=y
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
# CONFIG_ENABLE_COMP_AI_MODE_WAKEUP is not set
# CONFIG_ENABLE_COMP_AI_MODE_FREE is not set
CONFIG_ENABLE_COMP_AI_AUDIO=y
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_PCM=y
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
# CONFIG_ENABLE_COMP_AI_VIDEO is not set
# CONFIG_ENABLE_DISPLAY is not set
# CONFIG_ENABLE_CAMERA is not set
# CONFIG_ENABLE_LIBLVGL is not set
# CONFIG_ENABLE_AUDIO_AEC is not set
# CONFIG_ENABLE_AUDIO_AFE is not set
CONFIG_AI_CLIENT_STACK_SIZE=16384
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
