CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC79_DEVKITBOARD=y
CONFIG_ENABLE_BT_SERVICE=y
# CONFIG_ENABLE_NIMBLE is not set
CONFIG_ENABLE_MEDIA=y
CONFIG_ENABLE_AUDIO_CODECS=y
CONFIG_ENABLE_AI_COMPONENTS=y
CONFIG_ENABLE_COMP_AI_MODE_HOLD=y
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
# CONFIG_ENABLE_COMP_AI_MODE_WAKEUP is not set
# CONFIG_ENABLE_COMP_AI_MODE_FREE is not set
CONFIG_ENABLE_BUTTON=y
CONFIG_ENABLE_JIELI_ADKEY_BUTTON=y
# The AC79 DevKit drives a 320x480 ILI9488 panel over MCU8080, so the AI UI
# (LVGL v9) is available here.
CONFIG_ENABLE_COMP_AI_DISPLAY=y
CONFIG_ENABLE_AI_CHAT_GUI_WECHAT=y
CONFIG_ENABLE_DISPLAY=y
CONFIG_ENABLE_LIBLVGL=y
# Jieli needs more stack per frame than the upstream defaults. wq_highpri runs
# the BLE netcfg completion chain; wq_system the netmgr/TLS activation chain.
CONFIG_STACK_SIZE_MSG_QUEUE=10240
CONFIG_STACK_SIZE_WORK_QUEUE=8192
# The ai_client task runs an iotdns TLS handshake on its own stack when it
# fetches the CA for rtc-ai1-*.tuyacn.com.
CONFIG_AI_CLIENT_STACK_SIZE=8192
