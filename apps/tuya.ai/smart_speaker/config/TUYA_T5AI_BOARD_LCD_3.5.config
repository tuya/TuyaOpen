CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_TUYA_T5AI_BOARD_LCD_35565=y
# CONFIG_ENABLE_COMP_AI_PRESENT_MODE is not set
CONFIG_ENABLE_AI_UI_TEXT_STREAMING=y
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_BUTTION_STACK_SIZE=4096
# Uplink audio codec: OPUS (was PCM, the Kconfig default). Compresses ~16x vs
# raw PCM, so far less data accumulates during the session-start window ->
# lighter network and less head clipping. The choice option selects
# ENABLE_TUYA_CODEC_OPUS, which auto-registers the opus encoder.
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_OPUS=y
# The software opus encoder runs on the ai_agent_input thread; libopus needs
# several KB of stack (default 4608 -> UsageFault). Stack is in PSRAM.
CONFIG_AI_INPUT_STACK_SIZE=28672
# Input ring buffer holds raw PCM during the session-start window (~1s ~= 32KB)
# so the VAD pre-roll + utterance head isn't clipped (default 20480).
CONFIG_AI_INPUT_RINGBUF_SIZE=32768
