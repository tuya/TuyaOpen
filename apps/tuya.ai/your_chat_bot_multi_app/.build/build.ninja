  OBJECT_DIR = src/tal_kv/CMakeFiles/tal_kv.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libtal_kv.a
  TARGET_PDB = tal_kv.a.dbg


