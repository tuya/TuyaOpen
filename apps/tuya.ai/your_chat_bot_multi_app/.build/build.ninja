# Link the static library lib/libtal_system.a

build lib/libtal_system.a: C_STATIC_LIBRARY_LINKER__tal_system_ src/tal_system/CMakeFiles/tal_system.dir/src/tal_api.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_event.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_fs.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_log.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_sleep.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_sw_timer.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_system.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_thread.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_time_serivce.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_workq_service.c.o src/tal_system/CMakeFiles/tal_system.dir/src/tal_workqueue.c.o
  LANGUAGE_COMPILE_FLAGS = -g -Os -std=c99 -nostdlib -mthumb -Wall -Werror -Wno-format -Wno-unknown-pragmas -Wno-address-of-packed-member -ffunction-sections -fsigned-char -fdata-sections -fno-strict-aliasing -ggdb -std=gnu99 -Wno-old-style-declaration -mcpu=cortex-m33+nodsp -mfpu=fpv5-sp-d16 -mfloat-abi=hard -mcmse -end-group
  OBJECT_DIR = src/tal_system/CMakeFiles/tal_system.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libtal_system.a
  TARGET_PDB = tal_system.a.dbg


