build src/peripherals/button/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/wuchang/Documents/cursor/TuyaOpen/apps/tuya.ai/your_chat_bot_multi_app/.build/src/peripherals/button && /Users/wuchang/Documents/cursor/TuyaOpen/.venv/lib/python3.9/site-packages/cmake/data/bin/ccmake -S/Users/wuchang/Documents/cursor/TuyaOpen -B/Users/wuchang/Documents/cursor/TuyaOpen/apps/tuya.ai/your_chat_bot_multi_app/.build
