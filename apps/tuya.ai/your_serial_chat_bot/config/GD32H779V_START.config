CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_BOARD_CHOICE_GD32H77X=y
CONFIG_BOARD_CHOICE_GD32H779V_START=y
# CONFIG_ENABLE_COMP_AI_PRESENT_MODE is not set
# CONFIG_ENABLE_COMP_AI_AUDIO is not set
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
CONFIG_USER_CHAT_UART_NUMBER=0
# H779 TLS handshake runs on the AI client task.
CONFIG_AI_CLIENT_STACK_SIZE=16384
