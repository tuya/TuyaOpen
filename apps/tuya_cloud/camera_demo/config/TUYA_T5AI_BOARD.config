# camera_demo — TUYA_T5AI_BOARD: live GC2145 H264 + mic uplink / speaker downlink
# Usage:
#   cd apps/tuya_cloud/camera_demo
#   tos.py config choice -c TUYA_T5AI_BOARD.config
#   tos.py build
#
# Media: DVP camera H264 (opens on LIVE_VIDEO_START, closes on STOP)
# Audio: 16k mic -> G.711U uplink; APP G.711U -> GPIO28 speaker downlink
# Local store: App calendar PB + LIVE H264 append to /sdcard/media/rec/...

CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_BOARD=y
CONFIG_TUYA_T5AI_BOARD_VERSION_102=y
CONFIG_TUYA_T5AI_BOARD_LCD_NONE=y
CONFIG_TUYA_T5AI_BOARD_CAMERA=y

CONFIG_ENABLE_TUYA_P2P=y
# CONFIG_CAMERA_DEMO_P2P_FILE_H264 is not set
CONFIG_ENABLE_LOCAL_STORE=y
CONFIG_LOCAL_STORE_ROOT="/sdcard/media"
CONFIG_LOCAL_STORE_REC_SUBDIR="rec"
CONFIG_LOCAL_STORE_PATH_MAX=256
CONFIG_ENABLE_IPC_RING_BUFFER=y
CONFIG_CAMERA_DEMO_SD_LIVE_RECORD=y
CONFIG_CAMERA_DEMO_SD_RECORD_MAX_SEC=120
# CONFIG_CAMERA_DEMO_PB_SEED is not set

CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
