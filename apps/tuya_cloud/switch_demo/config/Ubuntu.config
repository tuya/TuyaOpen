# switch_demo - Ubuntu (LINUX): the cloud demo running as a host process.
# Usage:
#   cd apps/tuya_cloud/switch_demo
#   tos.py config choice -c Ubuntu.config
#   tos.py build
#
# Also the reproducible target for the POSIX half of the netmgr verification
# matrix: this is the only shipped config that selects the posix socket backend
# together with a wired link, so it is what exercises TAL_NET_PROVIDER_DEFAULT
# resolving to TAL_NET_TYPE_POSIX and netconn_wired.c being registered.

CONFIG_BOARD_CHOICE_LINUX=y
CONFIG_BOARD_CHOICE_UBUNTU=y

CONFIG_ENABLE_WIRED=y
# CONFIG_ENABLE_WIFI is not set

# Bluetooth stays off, and not by preference: tuya_iot.c calls netcfg_stop()
# from under ENABLE_BLUETOOTH, but netcfg's sources and include directory are
# added by src/tuya_cloud_service/CMakeLists.txt only under ENABLE_WIFI. So
# bluetooth-without-wifi does not compile. Turning it on here needs that gate
# fixed first - the right condition is the union of the provisioning-capable
# technologies, not wifi alone.
# CONFIG_ENABLE_BLUETOOTH is not set

CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
