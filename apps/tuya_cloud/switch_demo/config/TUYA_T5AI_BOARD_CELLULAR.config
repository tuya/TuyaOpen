# switch_demo - TUYA_T5AI_BOARD with the USB 4G module: wifi + cellular together.
# Usage:
#   cd apps/tuya_cloud/switch_demo
#   tos.py config choice -c TUYA_T5AI_BOARD_CELLULAR.config
#   tos.py build
#
# The RTOS half of the netmgr verification matrix, and the counterpart to
# Ubuntu.config. Ubuntu.config covers the posix socket backend with a single
# wired link; everything below is what that target cannot reach:
#
#   - the tkl socket backend, i.e. TAL_NET_PROVIDER_DEFAULT resolving to
#     TAL_NET_TYPE_TKL and a non-zero provider in the published route
#   - two links registered at once, which is the only shape where the policy
#     layer does any work at all: candidate ranking, DEGRADED demotion,
#     NETCONN_CAP_METERED avoidance and min_dwell_ms
#   - netconn_wifi.c and netconn_cellular.c, both absent from the host build
#   - NETCONN_CTRL_SUSTAINED, which only the cellular link uses
#   - the netmgr_cli wifi-present and cellular arms
#
# Board choice. TUYA_T5AI_BOARD is deliberate rather than the leanest T5AI
# board: its BOARD_CONFIG selects only audio codecs, LED and button, the LCD
# choice defaults to none and the camera defaults off, so it stays cheap to
# build - and it is the only board that carries the USB modem, so it is the
# only one that compiles the 4G power-up glue in tuya_t5ai_board.c.
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_BOARD=y

# Selects ENABLE_CELLULAR and pulls in the board-side USB modem bring-up.
# Setting CONFIG_ENABLE_CELLULAR directly would also work - it carries a prompt
# from src/tuya_cloud_service/Kconfig - but it would leave the board glue out.
CONFIG_ENABLE_T5AI_BOARD_CELLULAR_USB=y

# APN empty: the network picks a default bearer, which is what a consumer SIM
# wants. A private-network SIM needs a name here or it cannot attach.
CONFIG_CELLULAR_APN=""

# Compiles src/tal_wifi_ulp. Not needed by switch_demo at runtime; it is here
# because nothing else in the matrix builds that module, and a build that skips
# it reports SUCCESS while proving nothing about it.
CONFIG_ENABLE_WIFI_ULTRA_LOWPOWER=y

# ENABLE_WIFI and ENABLE_BLUETOOTH are absent on purpose. On T5AI both are
# declared in boards/T5AI/TKL_Kconfig as promptless bools defaulting to y, so a
# config file cannot move them - an assignment here would read as if it were
# doing something. They are already on, which is what this target wants.

CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
