# AC792N camera example.
#
# The platform pin (c967f4b1) has no DVP/CSI-2 TKL backend and its
# tuya_cloud_types.h predates TUYA_DVP_CFG_T.inter_cfg, so the JIELI camera
# TDD sources cannot compile or link yet. Keep both backends off until the
# platform-side camera adaptation (TuyaOpen-JieLi PR #23) lands, then flip
# ENABLE_DVP on (and ENABLE_BOARD_CAMERA_DVP for J49) or ENABLE_CSI2 on
# (and ENABLE_BOARD_CAMERA_CSI2 for J47). DVP and CSI-2 share PD11-PD14 and
# cannot be enabled together.
CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC792N_DEVELOP_BOARD=y
CONFIG_ENABLE_CAMERA=y
CONFIG_CAMERA_NAME="camera_dvp0"
CONFIG_ENABLE_DVP=y
CONFIG_ENABLE_BOARD_CAMERA_DVP=y
# CONFIG_ENABLE_CSI2 is not set
CONFIG_EXAMPLE_CAMERA_WIDTH=640
CONFIG_EXAMPLE_CAMERA_HEIGHT=480
CONFIG_EXAMPLE_CAMERA_FPS=20
CONFIG_EXAMPLE_CAMERA_IMG_ROTATION_0=y
# The WL83 DVP backend streams MJPEG (the vendor video server's only user
# format is AVI), so the example opens the encoded path and decodes each
# frame to RGB565 for the panel.
CONFIG_EXAMPLE_CAMERA_JPEG=y
# The shared tdd_audio.c is written against the T5AI/ESP32 audio contract
# (TKL_AUDIO_TYPE_BOARD, spk_sample, tkl_ao_clear_buffer) and does not build
# against the generic media contract this platform implements. This camera
# example needs no audio, so keep the codec out of the image; the JIELI sound
# path is tracked with task 07.
# CONFIG_ENABLE_MEDIA is not set
