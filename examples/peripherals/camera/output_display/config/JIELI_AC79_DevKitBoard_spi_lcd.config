CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC79_DEVKITBOARD=y
CONFIG_JIELI_CAMERA_PATH_SPI=y
CONFIG_ENABLE_CAMERA=y
CONFIG_ENABLE_DVP=y
CONFIG_JIELI_BOARD_CAMERA_WIDTH=640
CONFIG_JIELI_BOARD_CAMERA_HEIGHT=480
CONFIG_JIELI_BOARD_CAMERA_FPS=4
CONFIG_EXAMPLE_CAMERA_WIDTH=640
CONFIG_EXAMPLE_CAMERA_HEIGHT=480
CONFIG_EXAMPLE_CAMERA_FPS=4
CONFIG_EXAMPLE_DISPLAY_FRAME_BUFF_NUM=3
CONFIG_EXAMPLE_CAMERA_IMG_ROTATION_0=y
CONFIG_ENABLE_LIBLVGL=y
CONFIG_ENABLE_DISPLAY=y
CONFIG_ENABLE_MCU8080=y
# CONFIG_ENABLE_MEDIA is not set
CONFIG_JIELI_UART_LOG_PORT=1
CONFIG_JIELI_UART_LOG_BAUDRATE=115200
