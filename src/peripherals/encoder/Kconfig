
config ENABLE_ENCODER
    bool "enable encoder"
    default n

if (ENABLE_ENCODER)
    config ENCODER_NAME
        string "the name of encoder"
        default "encoder"

    config ENCODER_MAX_DEVICES
        int "maximum encoder devices"
        range 1 16
        default 4

    config ENCODER_TASK_STACK_SIZE
        int "encoder task stack size"
        range 1024 8192
        default 2048
endif
