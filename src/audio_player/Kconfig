menuconfig ENABLE_AI_PLAYER
    select ENABLE_AUDIO_CODECS
    bool "ENABLE_AI_PLAYER: Enable AI player"
    default n

    if (ENABLE_AI_PLAYER)
        config AI_PLAYER_STACK_SIZE
            int "AI_PLAYER_STACK_SIZE: player thread stack size"
            default 5120
        config AI_PLAYER_FRAMEBUF_SIZE
            int "AI_PLAYER_FRAMEBUF_SIZE: player frame buf size"
            default 4096
        config AI_PLAYER_DECODEBUF_SIZE
            int "AI_PLAYER_DECODEBUF_SIZE: player decode buf size"
            default 8192
        config AI_PLAYER_RINGBUF_SIZE
            int "AI_PLAYER_RINGBUF_SIZE: player ring buf size"
            default 16384
        config AI_PLAYER_HTTP_YIELD_MS
            int "AI_PLAYER_HTTP_YIELD_MS: player http yield ms"
            range 1 100
            default 10
        config AI_PLAYER_HTTP_TIMEOUT_S
            int "AI_PLAYER_HTTP_TIMEOUT_S: player http timeout seconds"
            range 60 300
            default 180
        menu "Decoder Options"
            config ENABLE_AI_PLAYER_DECODER_OPUS
                bool "ENABLE_AI_PLAYER_DECODER_OPUS: Enable OPUS decoder without any container"
                default n
            config AI_PLAYER_DECODER_OPUS_FRAME_SIZE
                depends on ENABLE_AI_PLAYER_DECODER_OPUS
                int "AI_PLAYER_DECODER_OPUS_FRAME_SIZE: OPUS decoder frame size in ms"
                default 40
                range 10 60
            config AI_PLAYER_DECODER_OPUS_KBPS
                depends on ENABLE_AI_PLAYER_DECODER_OPUS
                int "AI_PLAYER_DECODER_OPUS_KBPS: OPUS decoder kbps, 16kbps or 24kbps is recommended"
                default 16
                range 16 128
            config ENABLE_AI_PLAYER_DECODER_OGGOPUS
                depends on ENABLE_AI_PLAYER_DECODER_OPUS
                bool "ENABLE_AI_PLAYER_DECODER_OGGOPUS: Enable OGGOPUS decoder without any container"
                default n
        endmenu # Decoder Options
    endif # ENABLE_AI_PLAYER

config MP3_DECODER_STATIC_BUF
    bool "MP3_DECODER_STATIC_BUF: use static internal RAM for minimp3 scratch/context"
    default n
    help
      Place mp3dec_scratch_t, the decoder context and L12_scale_info in static
      buffers in TUYA_MEM_SECTION_RAM instead of allocating them per frame.

      This is about memory latency, not heap pressure. With ENABLE_EXT_RAM the
      MP3_MALLOC hook allocates from PSRAM, and decoding out of PSRAM cannot keep
      up: mp3dec_scratch_t (grbuf/syn, ~16KB) is read and written throughout every
      frame, which stutters audibly on SiWx917. Static internal RAM removes both
      the per-frame allocation and the PSRAM access latency.

      Costs ~24KB of internal RAM permanently and makes decoding non-reentrant,
      so enable it only for single-stream playback. The linker script must place
      the tuyaopen_bss_to_ram section (note: the section name has no leading dot).