set(COMPILE_PREFIX "${PLATFORM_PATH}/toolchain/gcc-arm-none-eabi-10-2020-q4-major/bin/arm-none-eabi-")
set(CMAKE_C_COMPILER "${COMPILE_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${COMPILE_PREFIX}g++")
set(CMAKE_ASM_COMPILER "${COMPILE_PREFIX}gcc")
set(CMAKE_AR "${COMPILE_PREFIX}ar")
set(CMAKE_RANLIB "${COMPILE_PREFIX}ranlib")
set(CMAKE_STRIP "${COMPILE_PREFIX}strip")
